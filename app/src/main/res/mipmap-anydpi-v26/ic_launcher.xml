<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon, API 26+.

  The mark is an instrument-cluster speedometer: an arc, a needle and a hub.
  That is literally what this app talks to, and it stays legible at 48px where
  anything more detailed turns to mush.

  Deliberately not drawn from anything TVS or Jupiter owns. Their marks are
  excluded on purpose — see research/SOURCES.md — and a gauge is generic enough
  that nobody can read it as a badge. Palette stays off their racing red.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>