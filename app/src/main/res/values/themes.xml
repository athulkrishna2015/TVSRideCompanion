<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MainActivity extends AppCompatActivity, which requires a
         Theme.AppCompat descendant. A plain android:Theme.Material crashes on
         launch with "You need to use a Theme.AppCompat theme". Compose supplies
         the real colours via TVSRideTheme. -->
    <style name="Theme.TVSRide" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
