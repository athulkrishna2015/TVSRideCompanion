<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer for themed icons. Same geometry as the foreground with the
  dial arc dropped, because a themed icon is a flat silhouette and the extra
  half-tone arc only muddies it. Solid black: the system replaces the colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M54,68 L70,42"
        android:strokeColor="#FF000000"
        android:strokeWidth="10"
        android:strokeLineCap="round" />

    <path
        android:pathData="M54,63 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0"
        android:fillColor="#FF000000" />
</vector>