<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground layer: a speedometer arc, a needle and a hub.

  Geometry matters more than it looks. Adaptive icons are 108x108 with only the
  middle 66x66 guaranteed visible under every mask, so the artwork is kept
  inside roughly 21..87 on both axes:

    arc    spans x 24..84, topmost point y=38   (radius 30, exact semicircle)
    needle runs from the hub (54,68) to (70,42)
    hub    is a filled dot at (54,68), r=5

  Strokes are 9 units with round caps so nothing tapers to a point at 48px.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dial arc. sweep=0 puts the sweep above the chord in a y-down space. -->
    <path
        android:pathData="M24,68 A30,30 0 0 0 84,68"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeAlpha="0.75" />

    <!-- Needle, angled off-vertical so it reads as "moving" not "idle". -->
    <path
        android:pathData="M54,68 L70,42"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />

    <!-- Hub. -->
    <path
        android:pathData="M54,63 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:fillColor="#FFFFFFFF" />
</vector>