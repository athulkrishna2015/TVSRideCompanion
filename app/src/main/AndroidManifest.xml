<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BLE to the cluster -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Map tiles, route search and turn-by-turn routing for the embedded map.
         Introduced for on-device OpenStreetMap navigation (see docs/MAPS.md).
         This is network access with a closed destination list, not a cloud
         account: tile.openstreetmap.org for tiles, router.project-osrm.org for
         keyless demo routing, api.graphhopper.com / api.mapbox.com only when
         the rider enters their own key (BYOK), nominatim.openstreetmap.org for
         place search. There is still no TVS account, no TVS server contact,
         and no telemetry upload anywhere in the app — grep the tree for
         HttpURLConnection if you do not believe the comment. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Read navigation from any maps app -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" xmlns:tools="http://schemas.android.com/tools" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Permissions mirrored from the working Jupiter companion app
      (com.tvs.jupiter, CC BY-NC 4.0 — see research/SOURCES.md), each with the
      reason it is wanted here.
    -->
    <!-- Doze parks the GATT connection within minutes and the cluster drops the
         link when the presence packet stops. Without this exemption a ride dies
         the moment the screen goes off, which is most of a ride. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Reconnect after a reboot or power cut. The cluster keeps advertising;
         nothing re-attaches without this. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Discovers which navigation app is actually installed, so mirroring is
         not limited to a hardcoded package list. Read-only; sees no app data. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- "Last Parked" has to be recorded while the phone is in a pocket with
         the screen off, which only a background location grant permits. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Caller ID on the cluster. TVS's Ntorq 125 manual lists "CALLER ID and
         SMS notification on speedometer" as a documented feature of the
         connected cluster, with a green smart-connect LED for an incoming call
         or message, so this is now requested rather than scoped out.

         READ_PHONE_STATE  - the phone is ringing / in a call
         READ_CALL_LOG     - missed calls, which the cluster shows like an SMS
         READ_CONTACTS     - resolve a number to a name for the display

         What the data can do: the app now holds INTERNET for map tiles and
         routing (see above), so the old "nowhere to send them" argument no
         longer applies and is not repeated here. The replacement guarantee is
         narrower and checkable: no code path transmits contact or call-log
         data. The only consumers are the caller-ID formatter (renders as
         bytes on the cluster) and the on-device contact resolver. The
         network call sites are confined to dev.tvsopen.nav.maps; grep
         HttpURLConnection to verify nothing else opens a connection.

         NOT requested: ANSWER_PHONE_CALLS and CALL_PHONE. Both are hard
         restricted from Android 10 — only the app the user has set as the
         default phone handler can ever hold them, and a third-party app asking
         is denied instantly. Declaring them would mean shipping a permission
         that can never be granted and a prompt that can only ever fail.
         Answering a call from the cluster would first require becoming the
         default dialer, which is a full InCallService and a different app. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Parked location, only when the user asks for it -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- No TVS contact, enforced by architecture rather than by audit.
         The app holds INTERNET solely for map tiles and routing (see the
         permission comment above and docs/MAPS.md). It never talks to TVS:
         no account, no registration, no SmartXonnect backend calls, and no
         telemetry upload. The network call sites are confined to
         dev.tvsopen.nav.maps; anything opening a connection from anywhere
         else is a bug. Contact and call-log data stay on the device — they
         are read only to render caller ID as bytes on the cluster. -->

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="TVSRide"
        android:supportsRtl="true"
        android:theme="@style/Theme.TVSRide">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".transport.RideService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Re-attach after reboot. Gated on the user having left the app in a
             riding state; see BootReceiver. -->
        <receiver
            android:name=".transport.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The whole point: read turn-by-turn from Google Maps or any other
             maps app without an account anywhere. -->
        <service
            android:name=".nav.MapsNotificationListener"
            android:exported="true"
            android:label="TVSRide navigation"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>